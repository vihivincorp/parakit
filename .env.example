
# LLM Provider Options:
# 1. Cloud: 'openai', 'openrouter', 'groq', 'anthropic'
# 2. Local Offline LLM (Ollama): 'ollama' (runs on http://localhost:11434/v1, zero internet, zero cost)
# 3. Local Offline LLM (LM Studio): 'lmstudio' (runs on http://localhost:1234/v1)
# 4. Built-in Offline Heuristic: 'mock' (instant offline answers, zero external dependencies)
LLM_PROVIDER=openai

# Cloud API Keys (Leave blank if using Ollama or mock)
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Model Configuration:
# For Cloud: gpt-4o-mini, llama-3.3-70b-versatile, claude-3-5-sonnet-latest
# For Ollama (Offline): llama3.2, deepseek-r1:8b, qwen2.5-coder, mistral
ASSISTANT_MODEL=gpt-4o-mini

# Optional Custom Local LLM URL (Default for Ollama is http://localhost:11434/v1)
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Audio & Speech Settings (Runs 100% Offline using local faster-whisper base model)
AUDIO_DEVICE_INDEX=
AUDIO_SAMPLE_RATE=16000
AUDIO_SOURCE=loopback

# Desktop Overlay UI
OVERLAY_TRANSPARENCY=0.50
EXCLUDE_FROM_CAPTURE=true
